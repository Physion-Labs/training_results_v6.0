{
  "model": {
    "name": "./models/Llama-2-70b-hf-fused-qkv-gu",
    "dtype": "bfloat16",
    "attn_implementation": "flash_attention_2"
  },
  "dataset": {
    "data_path": "./data/train.jsonl",
    "max_seq_len": 8192,
    "truncation_strategy": "left",
    "dataloader_num_workers": 8
  },
  "training": {
    "batch_size": 8,
    "num_train_epochs": 5,
    "max_steps": 550,
    "learning_rate": 0.0006,
    "weight_decay": 0.0001,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.0,
    "seed": "<from /dev/urandom per run>",
    "output_dir": "./output",
    "save_dtype": "bfloat16",
    "save_interval": 0,
    "val_dataset": "./data/validation_trim.jsonl",
    "eval_steps": 48
  },
  "optimizer": {
    "type": "adam",
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-08
  },
  "lora": {
    "train_type": "lora",
    "lora_rank": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "target_modules": [
      "qkv_proj",
      "o_proj"
    ]
  }
}